OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4

# Retrieval honesty (P0-1): max cosine distance for a chunk to count as relevant
# (Chroma cosine distance = 1 - similarity; 0 disables filtering). 0.85 answers
# real questions about a document (incl. "summarize this") while still rejecting
# off-topic ones; lower it to be stricter, raise it to be more permissive.
RETRIEVAL_MAX_DISTANCE=0.85

# Indexing limits (P0-2): guards against cost blow-up / memory DoS.
# Set any value to 0 to disable that individual limit. Keep MAX_UPLOAD_MB in sync
# with server.maxUploadSize in .streamlit/config.toml.
MAX_UPLOAD_MB=25
MAX_PAGES_PER_PDF=500
MAX_CHUNKS_PER_RUN=5000
MAX_FILES_PER_RUN=20

# OpenAI request controls (A5): per-request timeout (seconds), automatic retry
# budget, and the max tokens per generated answer.
REQUEST_TIMEOUT=30
MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024

# Indexing throughput: chunks per embedding request and how many requests run
# concurrently. Embedding round-trips dominate indexing time.
EMBED_BATCH_SIZE=256
EMBED_CONCURRENCY=8

# Logging (A7): application log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
